{
  "name": "ugrentals",
  "version": "1.0.0",
  "description": "UG Rentals — Express app serving a landing page and a JSON API",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "npm run test:node && npm run test:vitest",
    "test:node": "node --test \"test/node/**/*.test.js\"",
    "test:vitest": "vitest run"
  },
  "license": "MIT",
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
